 if(CURATED_ZH_VI[bareZh]){
  const vi=CURATED_ZH_VI[bareZh];
  const py=typeof pinyinForChinese==='function'?pinyinForChinese(bareZh):'';
  return {zh:bareZh,py,vi,source:'Từ điển tích hợp sẵn'};
 }
 // 2) Offline Vietnamese key samples (xinchao, camon, …)
 if(OFFLINE_SENTENCE_TRANSLATIONS[key])return {...OFFLINE_SENTENCE_TRANSLATIONS[key],source:'Câu mẫu tích hợp sẵn'};
 // 3) Exact match against sentence deck (full equality only)
 const exact=sentenceDeck.find(r=>[r.zh,r.py,r.vi].some(x=>norm(x)===key));
 if(exact)return {zh:exact.zh,py:exact.py,vi:exact.vi,source:'Câu mẫu tích hợp sẵn'};
 // 4) Exact dictionary headword (single word or short phrase)
 if(typeof dictionary!=='undefined'&&dictionary.length){
  const dictExact=dictionary.find(r=>norm(r[0])===key||norm(String(r[0]||'').replace(/[。！？.!?]+$/,''))===key);
  if(dictExact)return {zh:dictExact[0],py:dictExact[2]||'',vi:String(dictExact[3]||'').split(/[;；]/)[0].trim(),source:'Từ điển tích hợp sẵn'};
 }
 // 5) Ranked near-match: prefer similar length; reject pure substring supersets for short queries
 const qLen=key.length;
 if(qLen>=2){
  const scored=sentenceDeck.map(r=>{
   const fields=[r.zh,r.py,r.vi].map(x=>norm(x));
   let score=0;
   for(const f of fields){
    if(!f)continue;
    if(f===key)score=Math.max(score,100);
    else if(f.startsWith(key)&&f.length<=qLen+2)score=Math.max(score,60);
    else if(key.startsWith(f)&&qLen<=f.length+2)score=Math.max(score,40);
    // Substring-only (你好 inside 你好吗) gets low score and is only used if no better match
    else if((f.includes(key)||key.includes(f))&&Math.abs(f.length-qLen)<=3)score=Math.max(score,15);
   }
   return {r,score};
  }).filter(x=>x.score>=40).sort((a,b)=>b.score-a.score);
  if(scored.length)return {zh:scored[0].r.zh,py:scored[0].r.py,vi:scored[0].r.vi,source:'Câu mẫu gần nhất · kiểm tra lại ngữ cảnh'};
 }
