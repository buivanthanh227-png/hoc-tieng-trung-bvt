  else{output=new Float32Array(length);const ratio=decoded.sampleRate/rate;for(let i=0;i<length;i++){const x=i*ratio,a=Math.floor(x),b=Math.min(n-1,a+1),f=x-a;output[i]=mono[a]*(1-f)+mono[b]*f;}}
  if(output.length<8000)throw new Error('Bản ghi quá ngắn. Hãy nói ít nhất 1 giây rồi dừng.');
  let max=0;for(let i=0;i<output.length;i++)max=Math.max(max,Math.abs(output[i]));
  if(max>0&&max<0.78){const gain=Math.min(8,0.86/max);for(let i=0;i<output.length;i++)output[i]=Math.max(-1,Math.min(1,output[i]*gain));}
  return output;
 }finally{try{await ctx.close();}catch(_){}}
}
