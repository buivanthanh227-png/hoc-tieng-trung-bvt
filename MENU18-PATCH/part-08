function trainingNormalizeRow(row){
 if(!row)return null;
 const zh=String(Array.isArray(row)?(row[0]||''):(row.zh||row.hanzi||'')).trim();
 if(!zh||!/[\u3400-\u9fff]/.test(zh))return null;
 const py=String(Array.isArray(row)?(row[2]||''):(row.py||row.pinyin||'')||pinyinForChinese(zh)).trim();
 const vi=String(Array.isArray(row)?(row[3]||''):(row.vi||row.meaning||'')||offlineMeaningForChinese(zh)||'').trim();
 if(!vi)return null;
 return {zh,py:py||pinyinForChinese(zh),vi};
}
function trainingAddRows(rows,sourceLabel){
 let added=0,duplicates=0,invalid=0;
 for(const raw of rows||[]){
  const item=trainingNormalizeRow(raw?.row||raw);
  if(!item){invalid++;continue;}
  const key=item.zh.normalize('NFKC').replace(/\s+/g,'');
  if(vocabTrainingBank.has(key)){duplicates++;continue;}
  vocabTrainingBank.set(key,item);added++;
 }
 renderVocabularyTrainingBank();
 const status=$('vocab-training-source-status');
 if(status)status.textContent=`${sourceLabel}: thêm ${added} từ${duplicates?`, bỏ qua ${duplicates} từ trùng`:''}${invalid?`, bỏ qua ${invalid} mục thiếu nghĩa hoặc không hợp lệ`:''}. Tổng cộng ${vocabTrainingBank.size} từ.`;
 if(added)toast('Đã nạp '+added+' từ vào Luyện tập từ vựng.');
 else if(!rows?.length)toast('Nguồn này hiện chưa có từ vựng.');
 return added;
}
