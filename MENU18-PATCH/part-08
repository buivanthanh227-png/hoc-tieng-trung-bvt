function similarity(a,b){a=cleanAnswer(a);b=cleanAnswer(b);if(!a&&!b)return 1;if(!a||!b)return 0;if(a===b)return 1;let prev=Array(b.length+1).fill(0);for(let j=0;j<=b.length;j++)prev[j]=j;for(let i=1;i<=a.length;i++){const cur=[i];for(let j=1;j<=b.length;j++)cur[j]=Math.min(cur[j-1]+1,prev[j]+1,prev[j-1]+(a[i-1]===b[j-1]?0:1));prev=cur;}return Math.max(0,1-prev[b.length]/Math.max(a.length,b.length));}
function scoreAnswer(user,expected,aliases=[]){const cand=[expected,...aliases].filter(Boolean);let best=0;for(const c of cand){const s=similarity(user,c);best=Math.max(best,s);}const u=normVietnamese(user), ex=normVietnamese(expected);if(u&&ex&&u===ex)best=1;else if(u&&ex&&(ex.includes(u)||u.includes(ex))&&Math.min(u.length,ex.length)>=2)best=Math.max(best,Math.min(u.length,ex.length)/Math.max(u.length,ex.length)*.92);return Math.round(best*100);}
