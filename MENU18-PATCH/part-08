// Pointer-friendly handwriting canvas with faint character tracing; recognition is deliberately not claimed.
function initCanvas(){const canvas=$('writing-canvas');canvasContext=canvas.getContext('2d');canvas.addEventListener('pointerdown',e=>{drawing=true;canvas.setPointerCapture?.(e.pointerId);lastPoint=canvasPoint(e);drawLine(lastPoint,lastPoint);});canvas.addEventListener('pointermove',e=>{if(!drawing)return;const p=canvasPoint(e);drawLine(lastPoint,p);lastPoint=p;});const end=()=>{drawing=false;lastPoint=null;};canvas.addEventListener('pointerup',end);canvas.addEventListener('pointercancel',end);canvas.addEventListener('pointerleave',e=>{if(e.buttons===0)end();});}
function canvasPoint(e){const c=$('writing-canvas'),r=c.getBoundingClientRect();return {x:(e.clientX-r.left)*c.width/r.width,y:(e.clientY-r.top)*c.height/r.height};}
function clearCanvas(){if(!canvasContext)return;const c=$('writing-canvas');canvasContext.clearRect(0,0,c.width,c.height);drawTrace();}
function drawTrace(){if(!canvasContext)return;const c=$('writing-canvas');canvasContext.clearRect(0,0,c.width,c.height);if(showTrace&&traceChar){canvasContext.save();canvasContext.fillStyle='#e4e7ec';canvasContext.textAlign='center';canvasContext.textBaseline='middle';canvasContext.font='300 260px "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", sans-serif';canvasContext.fillText([...traceChar][0]||'',c.width/2,c.height/2+12);canvasContext.restore();}}
function drawLine(a,b){if(!canvasContext)return;canvasContext.save();canvasContext.strokeStyle='#202938';canvasContext.lineWidth=9;canvasContext.lineCap='round';canvasContext.lineJoin='round';canvasContext.beginPath();canvasContext.moveTo(a.x,a.y);canvasContext.lineTo(b.x,b.y);canvasContext.stroke();canvasContext.restore();}
$('clear-canvas').onclick=clearCanvas;$('show-trace').onclick=()=>{showTrace=!showTrace;drawTrace();};initCanvas();

