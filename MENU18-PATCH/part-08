 const frame=document.getElementById('number-practice-frame');
 if(!frame)return;
 window.addEventListener('message',function(event){
  if(event.source!==frame.contentWindow)return;
  const data=event.data||{};
  if(data.type!=='bvt-number-app-resize')return;
  const height=Number(data.height);
  if(Number.isFinite(height)&&height>300&&height<6000)frame.style.height=Math.max(700,Math.ceil(height+12))+'px';
 });
 frame.addEventListener('load',function(){try{frame.contentWindow.postMessage({type:'bvt-number-app-measure'},'*');}catch(_){}});
})();
</script>

