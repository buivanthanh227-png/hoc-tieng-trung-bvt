 try{
  const decoded=await ctx.decodeAudioData((await blob.arrayBuffer()).slice(0));
  if(session!==practiceReadSession)throw new Error('Lượt ghi âm đã bị hủy.');
  const n=decoded.length,channels=Math.max(1,decoded.numberOfChannels||1),mono=new Float32Array(n);
  for(let c=0;c<channels;c++){const ch=decoded.getChannelData(c);for(let i=0;i<n;i++)mono[i]+=ch[i]/channels;}
  let peak=0;for(let i=0;i<n;i++)peak=Math.max(peak,Math.abs(mono[i]));
  if(peak<0.0012)throw new Error('Micro thu quá nhỏ hoặc không có tiếng nói. Kiểm tra quyền micro rồi thử lại.');
