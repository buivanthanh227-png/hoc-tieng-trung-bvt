 if(!window.Worker)throw new Error('Trình duyệt không hỗ trợ Web Worker.');
 const worker=new Worker(new URL('./asr-worker.js', document.baseURI));practiceReadWorker=worker;
 worker.onmessage=e=>{
  const data=e.data||{};if(data.session!==practiceReadPendingSession||data.session!==practiceReadSession||practiceReadFallbackSession===data.session)return;
  if(data.type==='status'||data.type==='progress'){setReadAsrStatus('Đang nhận diện tiếng Trung…');return;}
  if(data.type==='result'){
   clearTimeout(practiceReadTimeout);practiceReadTimeout=null;
   const text=String(data.text||'').replace(/[\u0000-\u001f]/g,' ').replace(/\s+/g,' ').trim();
   practiceReadPendingSession=0;practiceReadPendingSamples=null;setReadMicState(false);
   if(text){$('user-answer').value=text;setReadAsrStatus('Đã nhận diện: '+text,true);handleReadSubmit(text,'local-whisper');}
   else{setReadAsrStatus('Chưa nhận diện được lời nói. Hãy nói rõ hơn và thử lại.',true);}
   return;
  }
  if(data.type==='error')practiceReadDirectFallback(practiceReadPendingSamples,data.session,'');
 };
 worker.onerror=e=>{
  if(practiceReadWorker===worker)practiceReadWorker=null;try{worker.terminate();}catch(_){}
  if(practiceReadPendingSession)practiceReadDirectFallback(practiceReadPendingSamples,practiceReadPendingSession,'');
 };
 return worker;
}
async function decodePracticeReadBlob(blob,session){
 const AudioCtx=window.AudioContext||window.webkitAudioContext,OfflineCtx=window.OfflineAudioContext||window.webkitOfflineAudioContext;
