}
function loadRadicalStroke(r){
 const stage=$('radical-modal-stroke-stage'),status=$('radical-modal-status'),replay=$('radical-modal-replay');
 if(!stage||!status||!replay)return;
 const character=String(r.char||'');
 try{radicalWriter?.pauseAnimation?.();}catch(_){}
 radicalWriter=null;activeRadicalChar=character;
 stage.innerHTML='';
 status.textContent='Đang tải dữ liệu nét cho bộ thủ '+character+'…';replay.disabled=true;
 if(typeof HanziWriter==='undefined'){
  status.textContent='Không tải được thư viện thứ tự nét. Hãy kiểm tra kết nối Internet rồi mở lại.';
  return;
 }
 const rect=stage.getBoundingClientRect();
 const size=Math.max(120,Math.min(270,Math.floor(Math.min(rect.width||270,rect.height||270)-18)));
 try{
  const writer=HanziWriter.create('radical-modal-stroke-stage',character,{
   width:size,height:size,padding:Math.max(4,Math.min(9,Math.round(size*.035))),renderer:'canvas',
   showOutline:true,strokeColor:'#0f766e',outlineColor:'#cbd5e1',
   delayBetweenStrokes:380,delayBetweenLoops:3000,strokeAnimationSpeed:1.12,
   onLoadCharDataSuccess:data=>{
    if(radicalWriter!==writer)return;
    status.textContent=`Tổng số nét: ${data.strokes?.length||r.strokes}. Tự động chạy lại sau 3 giây.`;
    replay.disabled=false;
   },
   onLoadCharDataError:()=>{
    if(radicalWriter!==writer)return;
    stage.innerHTML=`<span class="stroke-fallback-char">${escapeHTML(character||'部')}</span>`;
    status.textContent='Thư viện hiện không có dữ liệu hoạt ảnh cho bộ thủ này. Bạn có thể mở Bishun.net để tra cứu.';
    replay.disabled=true;
   }
  });
  radicalWriter=writer;
  if(typeof writer.loopCharacterAnimation==='function'){
   writer.loopCharacterAnimation();
  }else if(typeof writer.animateCharacter==='function'){
   writer.animateCharacter();
   status.textContent='Đang chạy hoạt ảnh một lượt; thư viện hiện tại không hỗ trợ tự lặp.';
  }
 }catch(err){
  radicalWriter=null;stage.innerHTML=`<span class="stroke-fallback-char">${escapeHTML(character||'部')}</span>`;
  status.textContent='Không thể tải hoạt ảnh cho bộ thủ này. Hãy thử mở Bishun.net.';
 }
}
function selectRadical(no){
