const COMBINE_STORAGE_KEY = 'cn-combine-selected-v2';
function saveSelectedCombine(){
 try{
  const data=[...selectedCombine.entries()].map(([word,item])=>({word,row:Array.isArray(item.row)?item.row.slice(0,5):[word,word,'',word,''],role:item.role||'auto'}));
  localStorage.setItem(COMBINE_STORAGE_KEY,JSON.stringify(data));
  const status=$('combine-save-status');
  if(status)status.textContent=data.length?'✅ Đã tự lưu '+data.length+' từ trên trình duyệt/thiết bị này.':'Danh sách từ đã được lưu (hiện đang trống).';
  return true;
 }catch(e){
  const status=$('combine-save-status');
  if(status)status.textContent='⚠️ Trình duyệt đang chặn lưu cục bộ. Hãy dùng cửa sổ bình thường, không dùng chế độ riêng tư.';
  return false;
 }
}
function restoreSelectedCombine(){
 try{
  const raw=localStorage.getItem(COMBINE_STORAGE_KEY);
  if(!raw)return 0;
  const data=JSON.parse(raw);if(!Array.isArray(data))return 0;
  selectedCombine.clear();
  for(const saved of data){
   if(!saved||typeof saved.word!=='string'||!Array.isArray(saved.row)||saved.row.length<4)continue;
   const word=String(saved.row[0]||saved.word).trim();if(!word||selectedCombine.has(word))continue;
   const row=[String(saved.row[0]||word),String(saved.row[1]||saved.row[0]||word),String(saved.row[2]||''),String(saved.row[3]||''),String(saved.row[4]||'')];
   selectedCombine.set(word,{row,role:roleHints[word]||saved.role||'auto'});
  }
  const status=$('combine-save-status');
  if(status&&selectedCombine.size)status.textContent='↩️ Đã khôi phục '+selectedCombine.size+' từ đã chọn từ lần trước trên thiết bị này.';
  return selectedCombine.size;
 }catch(e){return 0;}
