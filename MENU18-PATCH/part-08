function radicalArtFor(r,large=false){
 const type=RADICAL_ART_BY_NO[(Number(r.no)||1)-1]||'abstract';
 const shape=RADICAL_ART_SHAPES[type]||RADICAL_SVG_SHAPES.abstract;
 const palette=RADICAL_ART_PALETTE[(Number(r.no)-1)%RADICAL_ART_PALETTE.length]||RADICAL_ART_PALETTE[0];
 const title=String(r.meaning||r.pinyin||'Minh họa bộ thủ').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
 const glyph=String(r.char||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
 return `<svg class="radical-art-svg${large?' large':''}" viewBox="0 0 64 64" role="img" aria-label="${title}"><defs><linearGradient id="radbg${r.no}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${palette[0]}"/><stop offset="1" stop-color="#ffffff"/></linearGradient></defs><rect x="2" y="2" width="60" height="60" rx="14" fill="url(#radbg${r.no})" stroke="${palette[1]}" stroke-opacity=".35"/><g fill="none" stroke="${palette[1]}" stroke-width="2.9" stroke-linecap="round" stroke-linejoin="round">${shape}</g><circle cx="51" cy="50" r="10" fill="#fff" stroke="${palette[1]}" stroke-width="1.1"/><text x="51" y="54" text-anchor="middle" font-size="10" font-weight="800" fill="${palette[1]}" font-family="Noto Sans SC,Microsoft YaHei,sans-serif">${glyph}</text></svg>`;
}
function radicalSearchText(r){const extra=r.no===167?'金 钅 釒 jin jīn kim kimloai kimloại kimkhí vàng':' ';return norm([r.no,r.char,r.pinyin,r.meaning,r.variant,RADICAL_EXAMPLES[r.no]||'',extra].join(' '));}
function radicalVariantLabel(r){if(r.no===167)return '釒: 8 nét · 钅: 5 nét';return r.variant||'';}
function renderRadicals(){const raw=String($('radical-search')?.value||'').trim(),q=norm(raw).replace(/^bo/,'');const st=$('radical-stroke-filter')?.value||'all';const rows=RADICALS.filter(r=>(st==='all'||r.strokes===Number(st)||r.variantStrokes===Number(st))&&(!q||radicalSearchText(r).includes(q)));$('radical-result-count').textContent=rows.length+' / 214 bộ thủ';$('radical-list').innerHTML=rows.map(r=>`<button type="button" class="radical-item" data-radical-select="${r.no}"><span class="radical-visual"><span>${radicalArtFor(r)}</span><b>${r.char}</b></span><span class="radical-info"><b>#${r.no} · ${r.pinyin}</b><small>${r.no===167?'8 nét (金 chuẩn) · 5 nét (钅 giản thể)':r.strokes+' nét'}${r.variant?' · '+r.variant:''}${r.meaning?' · '+r.meaning:''}${RADICAL_EXAMPLES[r.no]?' · Ví dụ: '+RADICAL_EXAMPLES[r.no]:''}</small></span></button>`).join('')||'<div class="empty" style="grid-column:1/-1">Không tìm thấy bộ thủ phù hợp. Hãy thử chữ biến thể, Pinyin hoặc nghĩa tiếng Việt.</div>';}
function openRadicalStrokeModal(r){
 const modal=$('radical-stroke-modal');if(!modal)return;
 try{radicalWriter?.pauseAnimation?.();}catch(_){}
