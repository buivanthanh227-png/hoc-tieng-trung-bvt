// ===== Reflex practice: controlled Q&A templates generated only from selected words =====
const REFLEX_ADJECTIVES={累:'mệt',冷:'lạnh',热:'nóng',忙:'bận'};
const REFLEX_OBJECTS={
 喜欢:['苹果','咖啡','茶','中文','汉语','猫','狗','电影','音乐','书','水果','水'],
 吃:['苹果','米饭','菜','水果'],喝:['水','茶','咖啡'],
};
const REFLEX_PLACES=['家','学校','医院','商店','饭店','书店','机场','北京','中国'];
function createReflexPairs(){
 const has=w=>selectedCombine.has(w);const pairs=[];const seen=new Set();
 const add=(qTokens,aTokens,qVi,aVi,kind='dialogue')=>{
  if(!qTokens.length||!aTokens.length||!qTokens.concat(aTokens).every(has))return;
  const qZh=qTokens.join('')+'？',aZh=aTokens.join('')+'。';const key=qZh+'|'+aZh;if(seen.has(key))return;seen.add(key);
  pairs.push({qZh,aZh,qVi,aVi,kind,py:pinyinForChinese(aZh)});
 };
 // Personal states: 你…吗？ -> 我… / 我不…
 if(has('我')&&has('你')&&has('吗')){
  for(const [adj,meaning] of Object.entries(REFLEX_ADJECTIVES))if(has(adj)){
   add(['你',adj,'吗'],['我',adj],`Bạn có ${meaning} không?`,`Tôi ${meaning}.`);
   if(has('不'))add(['你',adj,'吗'],['我','不',adj],`Bạn có ${meaning} không?`,`Tôi không ${meaning}.`);
  }
  if(has('很')&&has('高兴'))add(['你','很','高兴','吗'],['我','很','高兴'],'Bạn có vui không?','Tôi rất vui.');
  // Likes and preferences with common, semantically compatible objects.
  for(const obj of REFLEX_OBJECTS['喜欢'])if(has('喜欢')&&has(obj)){
   add(['你','喜欢',obj,'吗'],['我','喜欢',obj],`Bạn có thích ${simpleGloss(token(obj).vi||token(obj).row?.[3]||obj).toLowerCase()} không?`,`Tôi thích ${simpleGloss(token(obj).vi||token(obj).row?.[3]||obj).toLowerCase()}.`);
   if(has('不'))add(['你','喜欢',obj,'吗'],['我','不','喜欢',obj],`Bạn có thích ${simpleGloss(token(obj).vi||token(obj).row?.[3]||obj).toLowerCase()} không?`,`Tôi không thích ${simpleGloss(token(obj).vi||token(obj).row?.[3]||obj).toLowerCase()}.`);
  }
  if(has('爱'))add(['你','爱','我','吗'],['我','爱','你'],'Bạn có yêu tôi không?','Tôi yêu bạn.');
  for(const [verb,objects] of Object.entries({想吃:['苹果','米饭','菜','水果'],想喝:['水','茶','咖啡']})){
   const parts=verb==='想吃'?['想','吃']:['想','喝'];
   for(const obj of objects)if(parts.every(has)&&has(obj))add(['你',...parts,obj,'吗'],['我',...parts,obj],`Bạn có muốn ${parts[1]==='吃'?'ăn':'uống'} ${simpleGloss(token(obj).vi||obj).toLowerCase()} không?`,`Tôi muốn ${parts[1]==='吃'?'ăn':'uống'} ${simpleGloss(token(obj).vi||obj).toLowerCase()}.`);
  }
  for(const modal of ['会','能','可以'])for(const lang of ['中文','汉语'])if(has(modal)&&has('说')&&has(lang)){
   const meaning=modal==='会'?'biết':modal==='能'?'có thể':'có thể';
   add(['你',modal,'说',lang,'吗'],['我',modal,'说',lang],`Bạn ${meaning} nói tiếng Trung không?`,`Tôi ${meaning} nói tiếng Trung.`);
  }
  for(const lang of ['中文','汉语'])if(has('学习')&&has(lang))add(['你','学习',lang,'吗'],['我','学习',lang],`Bạn có học tiếng Trung không?`,'Tôi học tiếng Trung.');
  if(has('认识'))add(['你','认识','我','吗'],['我','认识','你'],'Bạn có quen tôi không?','Tôi quen bạn.');
  if(has('知道'))add(['你','知道','吗'],['我','知道'],'Bạn có biết không?','Tôi biết.');
  if(has('工作'))add(['你','工作','吗'],['我','工作'],'Bạn có đi làm không?','Tôi đi làm.');
  for(const place of REFLEX_PLACES)if(has('在')&&has(place))add(['你','在',place,'吗'],['我','在',place],`Bạn có đang ở ${simpleGloss(token(place).vi||token(place).row?.[3]||place).toLowerCase()} không?`,`Tôi ở ${simpleGloss(token(place).vi||token(place).row?.[3]||place).toLowerCase()}.`);
  for(const place of REFLEX_PLACES.filter(p=>p!=='家'))if(has('去')&&has(place))add(['你','去',place,'吗'],['我','去',place],`Bạn có đi ${simpleGloss(token(place).vi||token(place).row?.[3]||place).toLowerCase()} không?`,`Tôi đi ${simpleGloss(token(place).vi||token(place).row?.[3]||place).toLowerCase()}.`);
  for(const obj of ['钱','手机','电脑','书','猫','狗','苹果'])if(has('有')&&has(obj))add(['你','有',obj,'吗'],['我','有',obj],`Bạn có ${simpleGloss(token(obj).vi||token(obj).row?.[3]||obj).toLowerCase()} không?`,`Tôi có ${simpleGloss(token(obj).vi||token(obj).row?.[3]||obj).toLowerCase()}.`);
  for(const obj of REFLEX_OBJECTS['吃'])if(has('吃')&&has(obj))add(['你','吃',obj,'吗'],['我','吃',obj],`Bạn có ăn ${simpleGloss(token(obj).vi||token(obj).row?.[3]||obj).toLowerCase()} không?`,`Tôi ăn ${simpleGloss(token(obj).vi||token(obj).row?.[3]||obj).toLowerCase()}.`);
  for(const obj of REFLEX_OBJECTS['喝'])if(has('喝')&&has(obj))add(['你','喝',obj,'吗'],['我','喝',obj],`Bạn có uống ${simpleGloss(token(obj).vi||token(obj).row?.[3]||obj).toLowerCase()} không?`,`Tôi uống ${simpleGloss(token(obj).vi||token(obj).row?.[3]||obj).toLowerCase()}.`);
