.vocab-training-answer-row .btn{min-height:40px;padding:8px 11px}
.vocab-training-answer-preview,.vocab-training-reveal{margin-top:10px;padding:10px 12px;border:1px solid var(--line);border-radius:11px;line-height:1.5;overflow-wrap:anywhere}
