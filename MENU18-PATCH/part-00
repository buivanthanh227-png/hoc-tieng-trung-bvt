.ocr-progress{height:8px;border-radius:99px;background:#e5e7eb;overflow:hidden;margin:-2px 0 12px}
.ocr-progress[hidden]{display:none!important}
.ocr-progress-fill{height:100%;width:0%;background:var(--red);border-radius:99px;transition:width .2s ease}
.ocr-progress-fill.indeterminate{width:35%;animation:ocr-indeterminate 1.15s ease-in-out infinite}
