.vocab-training-search-results{display:flex;flex-direction:column;gap:5px;max-height:260px;overflow:auto}
.vocab-training-result{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:8px;align-items:center;text-align:left;padding:7px 8px;border:1px solid var(--line);border-radius:9px;background:var(--surface,#fff);color:var(--ink);cursor:pointer}
