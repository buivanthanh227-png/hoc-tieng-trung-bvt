{
  "name": "hoc-tieng-trung-bvt-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Automated Playwright QA suite for Học Tiếng Trung BVT",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test tests/00-smoke.spec.js tests/01-menu-matrix.spec.js",
    "test:layout": "playwright test tests/02-responsive-layout.spec.js",
    "test:stress": "playwright test tests/03-input-fuzz.spec.js tests/04-repeat-navigation.spec.js",
    "test:offline": "RUN_OFFLINE_TESTS=1 playwright test tests/05-pwa-offline.spec.js",
    "report": "playwright show-report playwright-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "fast-check": "^3.23.2"
  }
}